{
  "name": "@kazutoyo/expo-google-mobile-ads",
  "version": "0.2.0",
  "description": "Expo Module wrapping the Google Mobile Ads (AdMob) SDK",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "plugin/build",
    "src",
    "ios",
    "android",
    "app.plugin.js",
    "expo-module.config.json",
    "CHANGELOG.md",
    "README.md",
    "README.ja.md",
    "!ios/build",
    "!android/build",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "build:plugin": "tsc --project plugin",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "jest --forceExit",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js",
    "typecheck": "tsc --noEmit && tsc --noEmit --project plugin"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-module",
    "admob",
    "google-mobile-ads",
    "ads",
    "advertising"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazutoyo/expo-google-mobile-ads.git"
  },
  "bugs": {
    "url": "https://github.com/kazutoyo/expo-google-mobile-ads/issues"
  },
  "author": "Kazutoyo Tokai <tokai.kazutoyo@tellernovel.com> (https://github.com/kazutoyo)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/kazutoyo/expo-google-mobile-ads#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "^26.3.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^16.1.2",
    "expo": "~58.0.24",
    "expo-modules-core": "~58.1.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.0.0",
    "react-native": "0.88.1",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "expo": ">=58.0.21",
    "react": "*",
    "react-native": "*"
  }
}
